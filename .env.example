# ───── AI 服务 ─────
# 阿里云百炼（DashScope），支持 Qwen 文本/ASR/TTS
AI_BAILIAN_API_KEY=
AI_BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# DeepSeek（可选）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# OpenAI（可选）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# ───── 默认模型 ─────
AI_DEFAULT_MODEL=qwen3.5-flash
AI_DEFAULT_EMBEDDING_MODEL=text-embedding-v3

# ───── 面试参数 ─────
INTERVIEW_FOLLOW_UP_COUNT=1
INTERVIEW_EVALUATION_BATCH_SIZE=8

# ───── PostgreSQL ─────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=hiremind
POSTGRES_USER=postgres
POSTGRES_PASSWORD=123456

# ───── Redis ─────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ───── 对象存储（MinIO / S3 兼容） ─────
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=hiremind

# ───── 安全 ─────
SESSION_SECRET_KEY=change-me-to-random-string
ENCRYPTION_KEY=32charrandomkeyforaikey

# ───── 日志 ─────
LOG_LEVEL=INFO
